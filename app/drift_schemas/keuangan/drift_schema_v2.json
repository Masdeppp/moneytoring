  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"initial_balance\" INTEGER NOT NULL DEFAULT 0, \"tone\" TEXT NOT NULL DEFAULT 'brand', \"icon\" TEXT NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"include_in_safe_to_spend\" INTEGER NOT NULL DEFAULT 1 CHECK (\"include_in_safe_to_spend\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"tone\" TEXT NOT NULL, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "obligations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"obligations\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"amount_type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"due_day\" INTEGER NOT NULL CHECK(\"due_day\" BETWEEN 1 AND 31), \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"account_id\" INTEGER NULL REFERENCES accounts (id), \"recurrence\" TEXT NOT NULL DEFAULT 'monthly', \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"auto_match_keywords\" TEXT NOT NULL DEFAULT '', \"starts_on\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "obligation_instances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"obligation_instances\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"obligation_id\" INTEGER NOT NULL REFERENCES obligations (id) ON DELETE CASCADE, \"due_date\" TEXT NOT NULL, \"expected_amount\" INTEGER NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', UNIQUE (\"obligation_id\", \"due_date\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"account_id\" INTEGER NOT NULL REFERENCES accounts (id), \"to_account_id\" INTEGER NULL REFERENCES accounts (id), \"category_id\" INTEGER NULL REFERENCES categories (id), \"date\" TEXT NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', \"obligation_instance_id\" INTEGER NULL REFERENCES obligation_instances (id) ON DELETE SET NULL, \"category_source\" TEXT NULL, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP));"
        }
      ]
    },
    {
      "name": "pay_cycle_configs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pay_cycle_configs\" (\"id\" INTEGER NOT NULL DEFAULT 1 CHECK(\"id\" = 1), \"payday_rule\" TEXT NOT NULL, \"day\" INTEGER NULL, \"shift_on_holiday\" INTEGER NOT NULL DEFAULT 1 CHECK (\"shift_on_holiday\" IN (0, 1)), \"expected_income\" INTEGER NOT NULL DEFAULT 0, \"tracking_since\" TEXT NOT NULL, \"buffer_basis_points\" INTEGER NOT NULL DEFAULT 500 CHECK(\"buffer_basis_points\" BETWEEN 0 AND 10000), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "savings_targets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"savings_targets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount_per_cycle\" INTEGER NOT NULL, \"account_id\" INTEGER NULL REFERENCES accounts (id));"
        }
      ]
    },
    {
      "name": "alerts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"alerts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"payload\" TEXT NOT NULL DEFAULT '{}', \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"read_at\" TEXT NULL, \"feedback\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "alert_thresholds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"alert_thresholds\" (\"type\" TEXT NOT NULL, \"value\" REAL NOT NULL, \"updated_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), PRIMARY KEY (\"type\"));"
        }
      ]
    },
    {
      "name": "entitlements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entitlements\" (\"product_id\" TEXT NOT NULL, \"purchase_token\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"verified_at\" TEXT NOT NULL, PRIMARY KEY (\"product_id\"));"
        }
      ]
    },
